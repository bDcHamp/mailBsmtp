# ==============================================================
# Webmail SMTP & Marketing Mailer Configuration
# Copy this file to .env and fill in your Webmail credentials
# ==============================================================

# Webmail / Custom Domain SMTP Server (cPanel, DirectAdmin, Plesk, etc.)
# Examples: mail.yourdomain.com, smtp.yourdomain.com
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=reminders@yourdomain.com
SMTP_PASSWORD=YourWebmailPasswordHere

# Security Protocol
# Port 465 is typically SSL (SMTP_USE_SSL=true)
# Port 587 is typically TLS/STARTTLS (SMTP_USE_TLS=true)
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# Sender Profile Information
SENDER_NAME=Marketing Operations Team
SENDER_EMAIL=reminders@yourdomain.com

# Email Subject
EMAIL_SUBJECT=Work Progress & Action Items Reminder

# Rate Limiting & Scheduling
# Default: 100 emails per client per 24-hour rolling window
DAILY_CAP_PER_CLIENT=100
WINDOW_HOURS=24.0

# Pacing interval in seconds between emails for the SAME client
# Default: 864 seconds (which is 24 hours / 100 emails = 14.4 minutes per email)
# Set to lower (e.g. 60 or 10) only for short testing runs
# MIN_INTERVAL_SECONDS=864

# Pause in seconds between any two outgoing emails to avoid webmail burst limits
GLOBAL_DISPATCH_DELAY=2.0

# ==============================================================
# Web Dashboard & Contabo VPS Server Settings
# ==============================================================
PORT=8085
HOST=0.0.0.0
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=ChangeThisSecurePassword123
SECRET_KEY=replace_with_a_random_secret_key_for_sessions
AUTO_START_ENGINE=false
